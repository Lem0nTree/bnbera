[Unit]
Description=BNBEra three-slot bounded testnet reference provider
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/bnbera-ui-light
ExecStart=/bin/bash /home/ubuntu/bnbera-ui-light/ops/reference-provider/service.sh
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Environment=T5_REFERENCE_SERVICE_ENABLED=true
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=60
LogRateLimitBurst=30

[Install]
WantedBy=default.target
