{
  "name": "@bnbera/altana",
  "version": "0.1.0",
  "private": true,
  "description": "Secret-free Altana policy, session-handoff, lifecycle, and evidence boundaries for BNBEra",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test --max-warnings 0",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@altananetwork/sdk": "0.9.0",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "3.600.0",
    "@types/express": "5.0.6",
    "express": "5.1.0"
  }
}
