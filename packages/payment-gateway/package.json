{
  "name": "@bnbera/payment-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Fail-closed X402/B402 challenge, relay, receipt, and reconciliation boundary for BNBEra",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue",
    "lint": "eslint src test --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bnbera/domain": "workspace:*",
    "zod": "3.24.1"
  }
}
