{
  "name": "bnbera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "clean": "pnpm --recursive --if-present run clean",
    "db:generate": "pnpm exec drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:check": "pnpm exec drizzle-kit check --config packages/db/drizzle.config.ts",
    "db:migrate": "pnpm --filter @bnbera/db run db:migrate",
    "evidence:check": "pnpm --filter @bnbera/evidence run check && pnpm --filter @bnbera/greenfield run check",
    "evidence:release-check": "tsx scripts/validate-release-evidence.ts",
    "ops:ingestion-smoke": "tsx scripts/ingestion-postgres-smoke.ts",
    "ops:erc8004scan": "tsx scripts/erc8004scan-ingestion.ts",
    "ops:erc8004-marketplace": "tsx scripts/erc8004-marketplace-ingestion.ts",
    "ops:marketplace-directory": "tsx scripts/marketplace-directory-sync.ts",
    "ops:marketplace-services": "tsx scripts/marketplace-service-refresh.ts",
    "ops:erc8004-category-backfill": "tsx scripts/erc8004-category-backfill.ts",
    "ops:marketplace-health": "tsx scripts/marketplace-health-job.ts",
    "ops:erc8004-registry-sync": "tsx scripts/erc8004-registry-sync.ts",
    "ops:erc8004-reputation-sync": "tsx scripts/erc8004-reputation-sync.ts",
    "ops:t5-reference-provider-setup": "tsx scripts/t5-reference-provider-setup.ts",
    "ops:t5-reference-provider-worker": "tsx scripts/t5-reference-provider-worker.ts",
    "ops:t5-reference-quoted-worker": "tsx scripts/t5-reference-quoted-worker.ts",
    "ops:t5-reference-registration": "tsx scripts/t5-reference-registration.ts",
    "ops:creator-worker": "tsx scripts/creator-worker.ts",
    "ops:t8-greenfield-inputs": "tsx scripts/t8-greenfield-inputs.ts",
    "ops:t4-canary": "tsx scripts/t4-operator-canary.ts",
    "ops:standards-check": "tsx scripts/standards-check.ts",
    "lint": "pnpm --recursive --if-present run lint",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@altananetwork/sdk": "0.9.0",
    "@aws-sdk/client-secrets-manager": "3.600.0",
    "@types/express": "5.0.6",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "drizzle-kit": "0.30.2",
    "eslint": "9.17.0",
    "express": "5.1.0",
    "pg": "8.13.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "viem": "2.56.3",
    "vitest": "2.1.8"
  }
}
