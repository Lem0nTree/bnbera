# Development-only example values. Never commit real credentials.
NODE_ENV=development
BNBERA_ENV=development
APP_URL=http://localhost:3000
SIWE_DOMAIN=localhost:3000
DATABASE_URL=postgresql://bnbera:bnbera@localhost:5432/bnbera
DATABASE_SSL=false
BSC_CHAIN_ID=97
BSC_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Optional read-only websocket endpoints for event/reorg verification. The
# current HTTP registry reader does not require these for deterministic tests.
BSC_MAINNET_WSS_URL=
BSC_TESTNET_WSS_URL=

# Optional read-only ERC-8004 pipeline gates. Keep disabled until release
# evidence and the standards lock are complete. Inject EIGHTSCAN_API_KEY via
# a secret manager at runtime; never place a real key in this file.
EIGHTSCAN_API_KEY=
ERC8004_INGESTION_ENABLED=false
ERC8004SCAN_DISCOVERY_ENABLED=false
# The checked-in standards lock is canary-only today. In development, a
# read-only canary requires both semantic flags and a matching embedding
# configuration; preview/production must leave both false.
MARKETPLACE_SEMANTIC_RETRIEVAL_ENABLED=false
MARKETPLACE_SEMANTIC_CANARY_ENABLED=false

# E2E test selection. Keep the pipeline gates above false in checked-in files;
# enable them only in the local test process after standards-lock validation.
ERC8004_E2E_CHAIN_ID=97
ERC8004_E2E_IDENTITY_REGISTRY=
ERC8004_E2E_AGENT_ID=
ERC8004_E2E_MAX_CANDIDATES=5
ERC8004_E2E_TIMEOUT_MS=30000

# Embedding configuration for the E2E adapter. The provider, model, version,
# and 1536 dimension must be reviewed and pinned before semantic retrieval is
# enabled. Inject the provider credential through a secret manager or an
# ignored local environment file; never commit its value.
ERC8004_EMBEDDING_PROVIDER=
ERC8004_EMBEDDING_MODEL=
ERC8004_EMBEDDING_MODEL_VERSION=
ERC8004_EMBEDDING_DIMENSION=1536
# Name of the server-side environment/secret-manager reference used by the adapter.
ERC8004_EMBEDDING_SECRET_REFERENCE=ERC8004_EMBEDDING_API_KEY
ERC8004_EMBEDDING_API_KEY=

# Browser/API verification. `live` must never silently fall back to fixtures.
MARKETPLACE_DATA_MODE=live
# Registered supply is browsable independently of the hire/publication gate.
MARKETPLACE_DIRECTORY_ENABLED=false
MARKETPLACE_DIRECTORY_SYNC_ENABLED=false
MARKETPLACE_DIRECTORY_LIMIT=100
# true resumes only identities without a completed directory observation.
MARKETPLACE_DIRECTORY_ONLY_MISSING=false
# Public Reown/WalletConnect configuration; set in apps/web/.env.local before build.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional server-only profile assistant (legacy CHEAPERINFERECE_KEY also accepted).
CHEAPERINFERENCE_API_KEY=
MARKETPLACE_API_URL=http://localhost:3000/api
BNBERA_MARKETPLACE_API_URL=http://localhost:3000/api/marketplace
BNBERA_EXPECT_ERROR=0

# G3 Creator local MVP. Keep the authority bridge and worker disabled unless
# the Studio workspace is an absolute owner-only path outside this repository
# (the managed Studio trial is temporary; never use a repository path).
# `T5_ALTANA_AUTH_ENABLED` is the retained passkey-auth gate used by Creator.
T5_ALTANA_AUTH_ENABLED=false
CREATOR_RUNTIME_AUTHORITY_ENABLED=false
CREATOR_WORKER_ENABLED=false
CREATOR_STUDIO_WORKSPACE_ROOT=/var/lib/bnbera/creator-studio
